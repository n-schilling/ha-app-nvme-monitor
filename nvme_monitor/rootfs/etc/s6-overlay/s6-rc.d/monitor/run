#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Reads the SMART log of every NVMe drive the app can read. Home Assistant
# gets one Drive problem sensor per drive through MQTT discovery; the whole
# log goes to STATUS_DIR, from which the web page shows it.
# ==============================================================================
readonly NODE='nvme_monitor'
readonly APP_NAME='NVMe Monitor'
readonly SUPPORT_URL='https://github.com/n-schilling/ha-app-nvme-monitor'
readonly AVAIL="${NODE}/availability"
# NVME_SYSFS only for the tests, which cannot fake /sys in a container
readonly SYSFS=${NVME_SYSFS:-/sys/class/nvme}
# One file per drive for the web page; NVME_STATUS_DIR only for the tests
readonly STATUS_DIR=${NVME_STATUS_DIR:-/run/nvme-monitor}
# The app's slug, e.g. e9773f93_nvme_monitor; the Supervisor names the
# container's host after it
readonly SLUG=${HOSTNAME//-/_}

PREFIX=$(bashio::config 'discovery_prefix')
DISCOVERY_PREFIX=${PREFIX}
INTERVAL=$(bashio::config 'interval')
EXPIRE=$((INTERVAL * 3))
# shellcheck disable=SC2034  # used by mqtt-device.sh
readonly PREFIX DISCOVERY_PREFIX INTERVAL EXPIRE
bashio::config.has_value 'log_level' && bashio::log.level "$(bashio::config 'log_level')"

# Stops the whole app instead of letting s6 restart the service every
# second: nothing changes until the user does something
fatal() {
    bashio::log.fatal "$1"
    echo 1 > /run/s6-linux-init-container-results/exitcode 2>/dev/null || true
    exec /run/s6/basedir/bin/halt
}

bashio::services.available 'mqtt' || fatal 'No MQTT service available; install and set up the MQTT broker first'

# The broker's address and credentials go to the configuration files the
# mosquitto clients read themselves, not on their command line, where every
# process that can list processes would see the password. The folder is
# root's only, so the web page cannot read it.
readonly MQTT_CONFIG=${NVME_MQTT_CONFIG:-/run/nvme-monitor-mqtt}
write_mqtt_config() {
    local -a lines=("-h $(bashio::services mqtt 'host')" "-p $(bashio::services mqtt 'port')")
    local user c
    user=$(bashio::services mqtt 'username')
    if bashio::var.has_value "${user}"; then
        lines+=("-u ${user}" "-P $(bashio::services mqtt 'password')")
    fi
    # A broker that wants TLS gets it, checked against the system's CAs
    if bashio::var.true "$(bashio::services mqtt 'ssl')"; then
        lines+=('--capath /etc/ssl/certs')
    fi
    install -d -m 700 "${MQTT_CONFIG}"
    for c in mosquitto_pub mosquitto_sub; do
        ( umask 077; printf '%s\n' "${lines[@]}" > "${MQTT_CONFIG}/${c}" )
    done
}
write_mqtt_config
export XDG_CONFIG_HOME=${MQTT_CONFIG}

pub() { mosquitto_pub -r -t "$1" -s; }
# shellcheck source=../../../../usr/local/lib/mqtt-device.sh
source /usr/local/lib/mqtt-device.sh
# Removes a retained message (mosquitto_pub refuses an empty message on stdin)
clear_topic() { mosquitto_pub -r -t "$1" -n; }

# The states of one round as topic, value, topic, value, ...
declare -a STATES=()

# Sends STATES. The first message the broker does not take ends it: the rest
# would fail the same way and only fill the log. PUB_ERROR holds the reason.
PUB_ERROR=''
send_states() {
    local i
    for (( i = 0; i < ${#STATES[@]}; i += 2 )); do
        PUB_ERROR=$(printf '%s' "${STATES[i + 1]}" | pub "${STATES[i]}" 2>&1) || return 1
    done
}

# Waits in the background, so the stop trap runs at once and not only after
# the interval (the tests bring their own pause)
declare -F pause > /dev/null || pause() { sleep "$1" & wait $!; }

# --- Drives ---------------------------------------------------------------------
# Every controller the app may read (config.yaml maps /dev/nvme0 to nvme3;
# the Supervisor skips the ones a host does not have). nvme0 keeps the IDs of
# the versions that only knew one drive. A drive whose SMART log fails at the
# start is monitored all the same: the main loop reports it and tries again
# every interval, so a drive that is slow after the boot is not lost.
declare -a DRIVES=()
for c in "${SYSFS}"/nvme[0-9]*; do
    [[ -e "${c}" ]] || continue
    d=${c##*/}
    if [[ -e "/dev/${d}" ]]; then
        DRIVES+=("${d}")
    else
        bashio::log.warning "Skipping ${d}: the app has no access to /dev/${d} (it reads nvme0 to nvme3)"
    fi
done
(( ${#DRIVES[@]} > 0 )) || fatal 'No NVMe drive found at /dev/nvme0 to /dev/nvme3'
readonly DRIVES

drive_node() { [[ "$1" == nvme0 ]] && echo "${NODE}" || echo "${NODE}_$1"; }
drive_name() { [[ "$1" == nvme0 ]] && echo 'Host NVMe' || echo "Host NVMe ${1#nvme}"; }

CFG_URL="homeassistant://hassio/addon/${SLUG}/info"
ORIGIN=$(jq -nc --arg app "${APP_NAME}" --arg version "${APP_VERSION:-unknown}" --arg url "${SUPPORT_URL}" \
    '{name:$app, sw_version:$version, support_url:$url}')
readonly CFG_URL ORIGIN

# The device of each drive for the discovery and the web page; model and
# firmware do not change while the app runs, so they are read once
declare -A DEVICE=()
for d in "${DRIVES[@]}"; do
    model=$(tr -s ' ' < "${SYSFS}/${d}/model" | sed 's/ *$//')
    fw=$(tr -d ' ' < "${SYSFS}/${d}/firmware_rev")
    DEVICE[${d}]=$(jq -nc --arg id "$(drive_node "${d}")" --arg name "$(drive_name "${d}")" \
        --arg model "${model}" --arg fw "${fw}" --arg cfg "${CFG_URL}" \
        '{identifiers:[$id], name:$name, model:$model, sw_version:$fw, configuration_url:$cfg}')
done
unset model fw
readonly DEVICE

# --- Availability ---------------------------------------------------------------
# A connection held open with a last will: if the app dies, the broker marks
# the entities unavailable. A regular stop publishes "offline" itself.
HOLD_SUB=''
hold_availability() {
    trap '[[ -n "${HOLD_SUB}" ]] && kill "${HOLD_SUB}" 2>/dev/null; exit 0' TERM
    while true; do
        mosquitto_sub -i "${SLUG}-availability" -q 1 -t "${AVAIL}" \
            --will-topic "${AVAIL}" --will-payload offline --will-retain --will-qos 1 \
            > /dev/null 2>&1 &
        HOLD_SUB=$!
        wait "${HOLD_SUB}"
        # In the background, so the stop trap runs at once
        sleep 10 & wait $!
    done
}

HOLDER=''
stop() {
    trap - EXIT TERM INT
    # Without a broker the last will of the held connection says offline
    printf 'offline' | pub "${AVAIL}" 2> /dev/null || true
    [[ -n "${HOLDER}" ]] && kill "${HOLDER}" 2>/dev/null
    exit 0
}

# --- Discovery, once and retained ---------------------------------------------
# One message per drive with all its entities; discover() adds one entity
# $1 node  $2 object_id  $3 display name  $4 platform  $5 extra JSON keys
COMPONENTS='{}'
discover() {
    COMPONENTS=$(jq -c --arg k "$2" --arg name "$3" --arg uid "$1_$2" --arg p "$4" \
        --arg stt "$1/$2" --argjson exp "${EXPIRE}" --argjson extra "${5:-\{\}}" \
        '.[$k] = ({platform:$p, name:$name, unique_id:$uid, default_entity_id:($p + "." + $uid),
                   state_topic:$stt, expire_after:$exp} + $extra)' <<< "${COMPONENTS}")
}

discover_drive() {
    local n
    n=$(drive_node "$1")
    COMPONENTS='{}'
    # The only entity: on for any sign that the drive needs attention. The
    # values themselves are on the web page
    discover "${n}" health_problem 'Drive problem' binary_sensor \
        "{\"device_class\":\"problem\",\"payload_on\":\"ON\",\"payload_off\":\"OFF\",
          \"json_attributes_topic\":\"${n}/health_problem/attr\"}"
    md_announce "${n}" "$(jq -nc --argjson c "${COMPONENTS}" --argjson dev "${DEVICE[$1]}" \
        --argjson origin "${ORIGIN}" --arg avail "${AVAIL}" \
        '{device:$dev, origin:$origin, availability_topic:$avail, qos:1, components:$c}')" \
        "${PREFIX}/+/${n}/+/config"
}

publish_discovery() {
    bashio::log.info 'Sending MQTT discovery...'
    local d t
    for d in "${DRIVES[@]}"; do
        discover_drive "${d}"
        # The values moved to the web page in 3.0.0: remove the retained
        # states of the sensors before; md_announce removed their entities
        for t in temp_composite temp_sensor1 temp_sensor2 data_written percent_used available_spare \
                 media_errors error_log unsafe_shutdowns throttle_count throttle_time throttle_active \
                 throttle_active/attr critical_warning; do
            clear_topic "$(drive_node "${d}")/${t}" || true
        done
    done
    # Host program crashes moved to Crash Guard in 2.0.0: remove the entities
    # and states of the versions before
    for t in "${PREFIX}/sensor/ha_host/crashes_boot/config" "${PREFIX}/sensor/ha_host/crashes_window/config" \
             ha_host/crashes_boot ha_host/crashes_window ha_host/crashes_window/attr \
             "${NODE}/crashes_boot" "${NODE}/crashes_window" "${NODE}/crashes_window/attr"; do
        clear_topic "${t}" || true
    done
}

# The previous SMART log per drive; empty = nothing to compare yet
declare -A PREV_SMART=()
# Throttling as reported for each drive: heat = throttling the temperatures
# explain, counter = the counters grew without any sign of heat; empty = none
declare -A THROTTLING=()
# How far below its lowest threshold the temperature may stay while throttling
# still counts as explained: the drive throttles between two readings, and
# the reading may come after it cooled down
readonly HEAT_MARGIN=10

# Host controlled thermal management thresholds (TMT1/TMT2) and warning
# thresholds, all relative to the composite temperature, in Kelvin; read once
# at the start, sent with every round
declare -A THRESHOLDS=()
# The lowest of these thresholds in °C; empty = the drive reports none
declare -A HEAT_LIMIT=()
# The drive's capacity in bytes; empty = not reported
declare -A CAPACITY=()
read_thresholds() {
    local dev="/dev/$1" ctrl hctm stages='{}'
    ctrl=$(nvme id-ctrl "${dev}" -o json 2>/dev/null) || return 1
    # Feature 0x10: TMT1 in bits 31:16, TMT2 in bits 15:0; 0 = not set
    if hctm=$(nvme get-feature "${dev}" -f 0x10 2>/dev/null | grep -o '0x[0-9a-f]*$'); then
        stages=$(jq -nc --argjson t1 $(( hctm >> 16 )) --argjson t2 $(( hctm & 0xffff )) \
            '{throttle_stage1_c:(if $t1 > 0 then $t1 - 273 else null end),
              throttle_stage2_c:(if $t2 > 0 then $t2 - 273 else null end)}')
    fi
    THRESHOLDS[$1]=$(jq -c --argjson st "${stages}" \
        '{warning_temp_c:(if (.wctemp // 0) > 0 then .wctemp - 273 else null end),
          critical_temp_c:(if (.cctemp // 0) > 0 then .cctemp - 273 else null end)} + $st' <<< "${ctrl}")
    HEAT_LIMIT[$1]=$(jq -j '[.[] | numbers] | min // empty' <<< "${THRESHOLDS[$1]}")
    CAPACITY[$1]=$(jq -j '.tnvmcap // empty' <<< "${ctrl}")
}

# Compares two SMART logs of a drive ($1 previous, $2 current, $3 lowest
# threshold or empty). Prints nothing when the throttling counters did not
# grow, "heat <reason>" when a temperature explains the throttling and
# "counter <°C>" when nothing does: some firmware counts more than thermal
# throttling in these fields, for example at temperatures far below the
# thresholds
throttle_verdict() {
    jq -rn --argjson p "$1" --argjson c "$2" --argjson limit "${3:-null}" --argjson margin "${HEAT_MARGIN}" '
        def throttle: [(.thm_temp1_trans_count // 0) + (.thm_temp2_trans_count // 0),
                       (.thm_temp1_total_time // 0) + (.thm_temp2_total_time // 0)];
        def grew(k): ($c[k] // 0) > ($p[k] // 0);
        (([$p.temperature, $c.temperature] | map(numbers) | max // 273) - 273) as $temp
        | if ($c | throttle) == ($p | throttle) then empty
          elif (($c.critical_warning // 0) / 2 | floor) % 2 == 1 then "heat the drive reports a temperature warning"
          elif grew("critical_comp_time") then "heat above its critical temperature"
          elif grew("warning_temp_time") then "heat above its warning temperature"
          elif $limit == null then "heat the drive reports no thresholds to check against"
          elif $temp >= $limit - $margin then "heat at \($temp) °C, threshold \($limit) °C"
          else "counter \($temp)" end'
}

# Logs the start and end of throttling once instead of on every reading
log_throttling() {
    local d=$1 kind=${2%% *} detail=${2#* }
    [[ -n "$2" ]] || kind=''
    [[ "${kind}" == "${THROTTLING[${d}]:-}" ]] && return 0
    case "${kind}" in
        heat) bashio::log.warning "Thermal throttling on ${d}: ${detail}" ;;
        counter) bashio::log.info "Throttling counters of ${d} grow at ${detail} °C, more than ${HEAT_MARGIN} °C below its lowest threshold of ${HEAT_LIMIT[${d}]} °C: not reported as throttling" ;;
        *) [[ "${THROTTLING[${d}]:-}" == heat ]] && bashio::log.info "Thermal throttling on ${d} ended" ;;
    esac
    THROTTLING[${d}]=${kind}
}

# What the last successful reading of each drive found, kept for the web
# page while the drive is not readable: the error log entries, the throttling
# verdict, the reasons and the time of that reading
declare -A LAST_ERRORS=() LAST_VERDICT=() LAST_REASONS=() READ_AT=()
# Since when a drive is not readable (seconds since the epoch); unset = readable
declare -A FAILING=()

# Writes the status file of drive $1 for the web page: $2 the SMART log or
# empty when it was not readable, $3 the throttling verdict, $4 the reasons.
# Written every round, readable or not: "at" tells the page that the monitor
# runs, "read_at" when the SMART log was last read.
write_status() {
    local d=$1 smart=${2:-null} file="${STATUS_DIR}/$1.json" now failing=null
    now=$(date +%s)
    [[ "${smart}" != null ]] || failing=${FAILING[${d}]:-null}
    if [[ "${smart}" != null ]]; then
        LAST_VERDICT[${d}]=${3:-}
        LAST_REASONS[${d}]=${4:-[]}
        READ_AT[${d}]=${now}
        LAST_ERRORS[${d}]='[]'
        # The entries themselves only when the drive counted some
        if jq -e '(.num_err_log_entries // 0) > 0' <<< "${smart}" > /dev/null; then
            LAST_ERRORS[${d}]=$(nvme error-log "/dev/${d}" -o json -e 16 2>/dev/null \
                | jq -c '[.errors[]? | select(.error_count > 0)]' 2>/dev/null) || LAST_ERRORS[${d}]='[]'
            [[ -n "${LAST_ERRORS[${d}]}" ]] || LAST_ERRORS[${d}]='[]'
        fi
    fi
    jq -nc --arg drive "${d}" --arg name "$(drive_name "${d}")" --argjson device "${DEVICE[${d}]}" \
        --argjson at "${now}" --argjson read_at "${READ_AT[${d}]:-null}" \
        --argjson failing "${failing}" \
        --argjson smart "${smart}" --argjson prev "${PREV_SMART[${d}]:-null}" \
        --argjson thresholds "${THRESHOLDS[${d}]:-null}" --argjson capacity "${CAPACITY[${d}]:-null}" \
        --arg verdict "${LAST_VERDICT[${d}]:-}" --argjson reasons "${LAST_REASONS[${d}]:-[]}" \
        --argjson errors "${LAST_ERRORS[${d}]:-[]}" --argjson margin "${HEAT_MARGIN}" '
        {drive:$drive, name:$name, model:$device.model, firmware:$device.sw_version, capacity:$capacity,
         at:$at, read_at:$read_at, failing_since:$failing,
         readable:($smart != null), smart:($smart // $prev // {}), thresholds:$thresholds, heat_margin:$margin,
         throttling:(if $verdict == "" then null
                     else {kind:($verdict | split(" ")[0]), detail:($verdict | sub("^[a-z]+ "; ""))} end),
         reasons:$reasons, errors:$errors}' \
        > "${file}.tmp" && mv "${file}.tmp" "${file}" \
        || bashio::log.warning "Cannot write the status of ${d} for the web page"
}

# Adds the states of a drive to STATES; fails when the drive is not readable
read_smart() {
    local j t
    j=$(nvme smart-log "/dev/$1" -o json 2>/dev/null) || return 1
    t=$(drive_node "$1")
    # A drive that was not readable at the start gets its thresholds now
    [[ -n "${THRESHOLDS[$1]:-}" ]] || read_thresholds "$1" || true
    # Throttling when the counters grew since the previous reading and a
    # temperature explains it
    local verdict=''
    if [[ -n "${PREV_SMART[$1]:-}" ]]; then
        verdict=$(throttle_verdict "${PREV_SMART[$1]}" "${j}" "${HEAT_LIMIT[$1]:-}") || return 1
    fi
    PREV_SMART[$1]=$(jq -c . <<< "${j}")
    log_throttling "$1" "${verdict}"
    local heat=''
    [[ "${verdict}" == heat* ]] && heat=${verdict#heat }
    # The reasons a drive needs attention; empty = healthy
    local reasons
    reasons=$(jq -c --arg heat "${heat}" '[
        (if (.critical_warning // 0) != 0 then "critical warning \(.critical_warning)" else empty end),
        (if (.media_errors // 0) > 0 then "\(.media_errors) media errors" else empty end),
        (if .avail_spare != null and .spare_thresh != null and .avail_spare <= .spare_thresh
            then "spare at \(.avail_spare) %, threshold \(.spare_thresh) %" else empty end),
        (if (.percent_used // 0) >= 100 then "rated endurance used up (\(.percent_used) %)" else empty end),
        (if $heat != "" then "thermal throttling, \($heat)" else empty end)
    ]' <<< "${j}") || return 1
    STATES+=("${t}/health_problem" "$(jq -j 'if length > 0 then "ON" else "OFF" end' <<< "${reasons}")"
             "${t}/health_problem/attr" "$(jq -c '{reasons: .}' <<< "${reasons}")")
    write_status "$1" "${j}" "${verdict}" "${reasons}"
}

# Readable for the web page, which runs as its own user
( umask 022; mkdir -p "${STATUS_DIR}" )
umask 022
hold_availability &
HOLDER=$!
trap stop EXIT TERM INT

publish_discovery
for d in "${DRIVES[@]}"; do
    read_thresholds "${d}" || bashio::log.warning "Temperature thresholds of ${d} not readable"
    bashio::log.info "Monitoring ${d}: $(jq -r '.model + " (firmware " + .sw_version + ")"' <<< "${DEVICE[${d}]}")"
done
bashio::log.info "Interval ${INTERVAL}s"

# Warnings once per outage, not on every interval
BROKER_AWAY=0
while true; do
    STATES=()
    for d in "${DRIVES[@]}"; do
        if read_smart "${d}"; then
            [[ -n "${FAILING[${d}]:-}" ]] && bashio::log.info "Reading ${d} works again"
            unset 'FAILING[${d}]'
        else
            if [[ -z "${FAILING[${d}]:-}" ]]; then
                bashio::log.warning "Reading ${d} failed, retrying every interval"
                FAILING[${d}]=$(date +%s)
            fi
            # The page shows the last readable log and since when it fails
            write_status "${d}" ''
        fi
    done
    # Again on every round, in case the broker lost its retained messages
    STATES+=("${AVAIL}" online)
    if send_states; then
        (( BROKER_AWAY )) && bashio::log.info 'MQTT broker answers again'
        BROKER_AWAY=0
    elif (( ! BROKER_AWAY )); then
        bashio::log.warning "MQTT broker not reachable (${PUB_ERROR:-no answer}), retrying every interval"
        BROKER_AWAY=1
    fi
    pause "${INTERVAL}"
done
