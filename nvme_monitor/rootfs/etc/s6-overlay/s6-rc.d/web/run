#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# The web page behind Home Assistant's ingress. It runs as its own user, so
# it has neither root nor the SYS_ADMIN capability the monitor needs to read
# the drives: a flaw in the web server cannot reach the drives through it.
# ==============================================================================
readonly USER_NAME=nvmeweb
readonly DIR=/data/web

# The history belongs to the page's user; 3.0.0 kept it in /data itself.
# The user copies it into its folder; root, which never works in that
# folder, only removes the old file from /data, which only root can write to.
install -d -o "${USER_NAME}" -g "${USER_NAME}" -m 700 "${DIR}"
if [[ -f /data/history.json && ! -L /data/history.json ]]; then
    # shellcheck disable=SC2016  # expanded by the inner shell
    if s6-setuidgid "${USER_NAME}" sh -c \
        '[ -e "$1" ] || { cp /data/history.json "$1.tmp" && mv -T "$1.tmp" "$1"; }' _ "${DIR}/history.json"; then
        rm -f /data/history.json
    else
        bashio::log.warning 'Could not take over the history of the web page from /data/history.json'
    fi
fi

# The options file is root's; the page only needs the interval. It gets no
# Supervisor token: it never talks to the Supervisor
NVME_INTERVAL=$(bashio::config 'interval')
export NVME_INTERVAL

bashio::log.info 'Starting the web page'
exec env -u SUPERVISOR_TOKEN s6-setuidgid "${USER_NAME}" python3 /usr/local/lib/nvme_web.py
